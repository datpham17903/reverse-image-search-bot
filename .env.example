# Bắt buộc (Discord Bot)
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

# Tuỳ chọn: Danh sách nhiều key SauceNAO cách nhau bằng dấu phẩy để xoay vòng (để trống vẫn tự động tìm qua web)
SAUCENAO_API_KEYS=
SAUCENAO_API_KEY=

# Tuỳ chọn: Tài khoản Danbooru (để trống vẫn tự động dùng Danbooru anonymous + IQDB.org đa booru 18+)
DANBOORU_LOGIN=
DANBOORU_API_KEY=
DANBOORU_USER_ID=

# Tuỳ chọn: Dự phòng Yandex qua Bright Data / SerpApi (mặc định đã dùng Yandex Direct miễn phí & full NSFW)
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
SERPAPI_API_KEY=

# Cấu hình hệ thống (Mặc định: Unlimited & Không Delay)
SQLITE_PATH=./data/bot.db
UNLIMITED_GATES=true
PARALLEL_SEARCH=true
ALLOW_CONCURRENT_USER_SEARCHES=true
USER_COOLDOWN_MS=0
USER_DAILY_SEARCHES=1000000
USER_DAILY_YANDEX=1000000
USER_DAILY_YANDEX_SERPAPI=250
TRACE_UNKNOWN_SHARE=1
BRIGHTDATA_MONTHLY_CREDITS=5000
SERPAPI_MONTHLY_SEARCHES=250
IMAGE_MAX_BYTES=10485760
IMAGE_MAX_PIXELS=20000000
ENGINE_TIMEOUT_MS=15000
JOB_DEADLINE_MS=60000
MAX_ACTIVE_JOBS=500
CACHE_HIT_TTL_DAYS=30
CACHE_MISS_TTL_HOURS=24
